{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ai-news-blog",
  "compatibility_date": "2026-05-27",
  "observability": {
    "enabled": true
  },
  "pages_build_output_dir": "public",
  "vars": {
    "HUGO_VERSION": "0.162.0"
  },
  "compatibility_flags": [
    "nodejs_compat"
  ]
}
